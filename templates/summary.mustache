{{!
    @template mod_leaderboard/summary

    Short summary shown under the leaderboard activity on the course page.

    Example context (json):
    {
        "cmid": 12,
        "name": "Course leaderboard",
        "url": "https://example.com/mod/leaderboard/view.php?id=12",
        "showboard": true,
        "nogroup": false,
        "empty": false,
        "toofew": false,
        "rows": [
            {"rank": 1, "points": "240", "name": "Rahim Uddin", "isme": false, "istop": true, "medal": "Gold"},
            {"rank": 2, "points": "198", "name": "Nusrat Jahan", "isme": true, "istop": true, "medal": "Silver"}
        ],
        "me": {"rank": 2, "points": "198", "total": 48, "text": "You are #2 of 48 with 198 points"},
        "total": 48,
        "updated": "16/10/26, 10:30"
    }
}}
<div class="mod-leaderboard-summary" data-region="mod-leaderboard-summary">
    {{#showboard}}
    <ol class="mod-leaderboard-summary-list list-unstyled mb-1">
        {{#rows}}
        <li class="mod-leaderboard-summary-row d-flex align-items-center{{#isme}} mod-leaderboard-isme{{/isme}}">
            <span class="mod-leaderboard-rank mod-leaderboard-rank-{{rank}}"{{#medal}} title="{{medal}}"{{/medal}}>{{rank}}</span>
            <span class="mod-leaderboard-name flex-grow-1 text-truncate">{{name}}{{#isme}} <span class="badge bg-primary">{{#str}}you, mod_leaderboard{{/str}}</span>{{/isme}}</span>
            <span class="mod-leaderboard-points">{{#str}}pointsshort, mod_leaderboard, {{points}}{{/str}}</span>
        </li>
        {{/rows}}
    </ol>
    {{#me}}
    <p class="mod-leaderboard-me mb-0"><strong>{{text}}</strong></p>
    {{/me}}
    {{/showboard}}
    {{#nogroup}}
    <p class="mb-0 text-muted">{{#str}}nogroup, mod_leaderboard{{/str}}</p>
    {{/nogroup}}
    {{#empty}}
    <p class="mb-0 text-muted">{{#str}}nostudents, mod_leaderboard{{/str}}</p>
    {{/empty}}
    {{#toofew}}
    <p class="mb-0 text-muted">{{#str}}toofew, mod_leaderboard{{/str}}</p>
    {{/toofew}}
</div>
