{{!
    @template mod_leaderboard/mobile_course_page

    The leaderboard as it appears on the Moodle app's course page. It replaces the activity's
    title there, so it starts with the name. Plain HTML only: no app components.

    Example context (json):
    {
        "name": "Course leaderboard",
        "url": "https://example.com/mod/leaderboard/view.php?id=12",
        "showsummary": true,
        "showboard": true,
        "rows": [{"rank": 1, "points": "240", "name": "Rahim Uddin", "isme": false}],
        "me": {"text": "You are #2 of 48 with 198 points"}
    }
}}
<div class="mod-leaderboard-appcard">
    <strong>{{name}}</strong>
    {{#showsummary}}
    {{#showboard}}
    <ol style="margin: 0.25em 0 0; padding-left: 1.4em;">
        {{#rows}}
        <li>{{#isme}}<strong>{{/isme}}{{name}} &mdash; {{#str}}pointsshort, mod_leaderboard, {{points}}{{/str}}{{#isme}}</strong>{{/isme}}</li>
        {{/rows}}
    </ol>
    {{#me}}<div style="margin-top: 0.25em;">{{text}}</div>{{/me}}
    {{/showboard}}
    {{/showsummary}}
    <div style="margin-top: 0.25em;"><a href="{{url}}">{{#str}}seefull, mod_leaderboard{{/str}}</a></div>
</div>
