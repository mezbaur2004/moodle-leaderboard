{{!
    @template mod_leaderboard/breakdown

    How one student's points were calculated.

    Example context (json):
    {
        "title": "Your points",
        "hasrows": true,
        "rows": [
            {"name": "Essay 1", "url": "https://example.com/mod/assign/view.php?id=3", "type": "Assignment",
             "mark": "40", "grademax": "50", "permark": "2", "late": false, "points": "80"},
            {"name": "Essay 2", "url": null, "type": "Assignment",
             "mark": "30", "grademax": "50", "permark": "1", "late": true, "points": "30"}
        ],
        "total": "110"
    }
}}
<section id="leaderboard-breakdown" class="mod-leaderboard-breakdown mt-4" aria-labelledby="leaderboard-breakdown-title">
    <h3 id="leaderboard-breakdown-title" class="h4">{{title}}</h3>
    {{#hasrows}}
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}activity, mod_leaderboard{{/str}}</th>
                <th scope="col">{{#str}}mark, mod_leaderboard{{/str}}</th>
                <th scope="col">{{#str}}permark, mod_leaderboard{{/str}}</th>
                <th scope="col" class="text-end">{{#str}}points, mod_leaderboard{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td>
                    {{#url}}<a href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}{{{name}}}{{/url}}
                    <div class="small text-muted">{{type}}</div>
                </td>
                <td>{{#str}}markoutof, mod_leaderboard, { "mark": "{{mark}}", "max": "{{grademax}}" }{{/str}}</td>
                <td>
                    {{permark}}
                    {{#late}}<span class="badge bg-warning text-dark ms-1">{{#str}}late, mod_leaderboard{{/str}}</span>{{/late}}
                </td>
                <td class="text-end">{{points}}</td>
            </tr>
            {{/rows}}
        </tbody>
        <tfoot>
            <tr>
                <th scope="row" colspan="3">{{#str}}total, mod_leaderboard{{/str}}</th>
                <td class="text-end"><strong>{{total}}</strong></td>
            </tr>
        </tfoot>
    </table>
    {{/hasrows}}
    {{^hasrows}}
    <p class="text-muted">{{#str}}nopointsyet, mod_leaderboard{{/str}}</p>
    {{/hasrows}}
</section>
