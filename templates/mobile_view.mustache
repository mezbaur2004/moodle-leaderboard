<%!
    @template mod_leaderboard/mobile_view

    The leaderboard page in the Moodle app. Rendered by Moodle, then compiled by the app
    (Angular). Every text value is escaped by classes/output/mobile.php::escape_for_app(),
    which also turns curly brackets and at signs into entities so Angular never reads a
    name as template code, so values are printed unescaped (with an ampersand tag). They
    are also wrapped in ngNonBindable; app strings ("translate") must stay outside those
    elements, or Angular would not translate them. The app does not load styles.css, so
    the student's own row is marked with markup only.

    Example context (json):
    {
        "showboard": true, "nogroup": false, "empty": false, "toofew": false,
        "rows": [{"rank": 1, "points": "240", "name": "Rahim Uddin", "isme": false}],
        "me": {"text": "You are #2 of 48 with 198 points"},
        "meoutside": false, "merow": null,
        "updatedtext": "Updated 16/10/26, 10:30",
        "breakdown": {"title": "Your points", "hasrows": true, "total": "110",
            "rows": [{"name": "Essay 1", "type": "Assignment", "mark": "40", "grademax": "50",
                      "permark": "2", "late": false, "points": "80"}]}
    }
%>
<div class="mod-leaderboard-mobile">
    <%#me%>
    <ion-card>
        <ion-card-content>
            <p class="item-heading"><strong ngNonBindable><%& text %></strong></p>
        </ion-card-content>
    </ion-card>
    <%/me%>

    <%#showboard%>
    <ion-list>
        <%#rows%>
        <ion-item>
            <ion-badge slot="start" color="<%#isme%>primary<%/isme%><%^isme%>medium<%/isme%>"><% rank %></ion-badge>
            <ion-label>
                <p class="item-heading" ngNonBindable><%#isme%><strong><%/isme%><%& name %><%#isme%></strong><%/isme%></p>
            </ion-label>
            <ion-note slot="end" ngNonBindable><%& points %></ion-note>
        </ion-item>
        <%/rows%>
        <%#meoutside%>
        <%#merow%>
        <ion-item>
            <ion-badge slot="start" color="primary"><% rank %></ion-badge>
            <ion-label>
                <p class="item-heading" ngNonBindable><strong><%& name %></strong></p>
            </ion-label>
            <ion-note slot="end" ngNonBindable><%& points %></ion-note>
        </ion-item>
        <%/merow%>
        <%/meoutside%>
    </ion-list>
    <%/showboard%>

    <%#nogroup%>
    <ion-card><ion-card-content><p>{{ 'plugin.mod_leaderboard.nogroup' | translate }}</p></ion-card-content></ion-card>
    <%/nogroup%>
    <%#empty%>
    <ion-card><ion-card-content><p>{{ 'plugin.mod_leaderboard.nostudents' | translate }}</p></ion-card-content></ion-card>
    <%/empty%>
    <%#toofew%>
    <ion-card><ion-card-content><p>{{ 'plugin.mod_leaderboard.toofew' | translate }}</p></ion-card-content></ion-card>
    <%/toofew%>

    <%#breakdown%>
    <ion-list>
        <ion-list-header>
            <ion-label><h2 ngNonBindable><%& title %></h2></ion-label>
        </ion-list-header>
        <%#rows%>
        <ion-item>
            <ion-label>
                <p class="item-heading" ngNonBindable><%& name %></p>
                <p><span ngNonBindable><%& type %> &middot; <%& mark %> / <%& grademax %> &times; <%& permark %></span><%#late%> &middot; {{ 'plugin.mod_leaderboard.late' | translate }}<%/late%></p>
            </ion-label>
            <ion-note slot="end" ngNonBindable><%& points %></ion-note>
        </ion-item>
        <%/rows%>
        <%#hasrows%>
        <ion-item>
            <ion-label><p class="item-heading">{{ 'plugin.mod_leaderboard.total' | translate }}</p></ion-label>
            <ion-note slot="end" ngNonBindable><strong><%& total %></strong></ion-note>
        </ion-item>
        <%/hasrows%>
        <%^hasrows%>
        <ion-item><ion-label><p>{{ 'plugin.mod_leaderboard.nopointsyet' | translate }}</p></ion-label></ion-item>
        <%/hasrows%>
    </ion-list>
    <%/breakdown%>

    <%#updatedtext%>
    <p class="ion-text-center ion-padding-horizontal"><small ngNonBindable><%& updatedtext %></small></p>
    <%/updatedtext%>
    <p class="ion-text-center ion-padding-horizontal"><small>{{ 'plugin.mod_leaderboard.mobile_pulltorefresh' | translate }}</small></p>
</div>
