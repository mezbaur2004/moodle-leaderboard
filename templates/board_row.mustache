{{!
    @template mod_leaderboard/board_row

    One row of the full leaderboard.

    Example context (json):
    {"rank": 1, "points": "240", "name": "Rahim Uddin", "picture": "", "isme": false, "istop": true,
     "medal": "Gold", "breakdownurl": null}
}}
<tr class="mod-leaderboard-row{{#isme}} mod-leaderboard-isme table-primary{{/isme}}"{{#isme}} aria-current="true"{{/isme}}>
    <td class="mod-leaderboard-col-rank">
        <span class="mod-leaderboard-rank mod-leaderboard-rank-{{rank}}">{{rank}}</span>
        {{#medal}}<span class="visually-hidden">{{medal}}</span>{{/medal}}
    </td>
    <td>
        <span class="d-inline-flex align-items-center">
            {{#picture}}<span class="me-2">{{{picture}}}</span>{{/picture}}
            <span>{{name}}</span>
            {{#isme}}<span class="badge bg-primary ms-2">{{#str}}you, mod_leaderboard{{/str}}</span>{{/isme}}
        </span>
    </td>
    <td class="text-end">
        {{#breakdownurl}}<a href="{{breakdownurl}}" title="{{#str}}showbreakdown, mod_leaderboard{{/str}}">{{points}}</a>{{/breakdownurl}}
        {{^breakdownurl}}{{points}}{{/breakdownurl}}
    </td>
</tr>
